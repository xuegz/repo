<view class="chat-page">
  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation>
    <view wx:if="{{loading}}" class="chat-tip">加载中…</view>

    <view wx:elif="{{empty}}" class="chat-empty">
      <view class="chat-empty-title">开始和 {{merchantName}} 沟通</view>
      <view class="chat-empty-sub">可以发文字、发图片，也可以从商品详情直接带商品卡片过来</view>
      <view class="chat-empty-sub">长按商户消息可提交举报</view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="chat-row {{item.sender === 'user' ? 'chat-row-self' : ''}}">
      <view wx:if="{{item.type === 'text'}}" class="chat-bubble {{item.sender === 'user' ? 'bubble-self' : 'bubble-other'}}"
            data-sender="{{item.sender}}" bindlongpress="onBubbleLongPress">{{item.content}}</view>

      <image wx:elif="{{item.type === 'image'}}" class="chat-img" src="{{item.content}}" mode="widthFix"
             data-url="{{item.content}}" data-sender="{{item.sender}}" bindtap="previewImage" bindlongpress="onBubbleLongPress" />

      <view wx:elif="{{item.type === 'product'}}" class="chat-product" data-id="{{item.product.id}}" bindtap="openProduct">
        <image wx:if="{{item.product.image}}" class="chat-product-img" src="{{item.product.image}}" mode="aspectFill" />
        <view class="chat-product-info">
          <view class="chat-product-name">{{item.product.name}}</view>
          <view class="chat-product-price" wx:if="{{item.product.price > 0}}">¥{{item.product.price}}<text wx:if="{{item.product.unit}}">/{{item.product.unit}}</text></view>
          <view class="chat-product-price" wx:else>面议</view>
        </view>
      </view>

      <view class="chat-time">{{item.timeText}}</view>
    </view>

    <view class="chat-bottom-space"></view>
  </scroll-view>

  <view class="chat-bar">
    <view class="chat-bar-tool" bindtap="chooseImage">图片</view>
    <input class="chat-bar-input" value="{{input}}" placeholder="输入消息…" placeholder-class="chat-bar-placeholder"
           confirm-type="send" cursor-spacing="20" bindinput="onInput" bindconfirm="sendText" />
    <view class="chat-bar-send {{input ? 'chat-bar-send-active' : ''}}" bindtap="sendText">发送</view>
  </view>
</view>
