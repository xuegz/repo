<wxs src="../../utils/tools.wxs" module="tools" />
<view class="msg-page">
  <view wx:if="{{locked}}" class="msg-empty">
    <view class="msg-empty-icon">会</view>
    <view class="msg-empty-title">在线咨询为会员专享</view>
    <view class="msg-empty-sub">绑定商户账号并开通会员后，可直接与同行商户在线沟通、接收消息提醒</view>
    <button class="msg-empty-btn" bindtap="goMember">{{memberBound ? '会员已到期，去开通' : '绑定商户账号'}}</button>
  </view>

  <view wx:elif="{{loading}}" class="msg-empty">加载中…</view>

  <view wx:elif="{{list.length === 0}}" class="msg-empty">
    <view class="msg-empty-icon">信</view>
    <view class="msg-empty-title">还没有消息</view>
    <view class="msg-empty-sub">在商户主页或商品详情点「在线咨询」，就能直接和商户沟通</view>
    <button class="msg-empty-btn" bindtap="goHome">去看看</button>
  </view>

  <view wx:else class="msg-list">
    <view class="msg-item" wx:for="{{list}}" wx:key="conversationId" data-item="{{item}}" bindtap="openChat" hover-class="msg-item-hover" hover-stay-time="60">
      <image wx:if="{{item.merchantLogo}}" class="msg-avatar-img" src="{{tools.thumbUrl(item.merchantLogo, 160)}}" mode="aspectFill" />
      <view wx:else class="msg-avatar">{{item.initial}}</view>
      <view class="msg-main">
        <view class="msg-row">
          <text class="msg-name">{{item.merchantName}}</text>
          <text class="msg-time">{{item.timeText}}</text>
        </view>
        <view class="msg-preview">{{item.lastContent}}</view>
      </view>
      <view wx:if="{{item.unread > 0}}" class="msg-badge">{{item.badge}}</view>
    </view>
  </view>

  <view class="msg-tip" wx:if="{{list.length > 0}}">消息仅用于沟通商品与价格，请勿在聊天中转账</view>
</view>
