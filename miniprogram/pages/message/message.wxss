.msg-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.msg-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.msg-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.msg-item:last-child {
  border-bottom: none;
}

.msg-item-hover {
  background: #f7f8fa;
}

.msg-avatar,
.msg-avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.msg-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff3e8;
  color: #ff7a00;
  font-size: 36rpx;
  font-weight: 600;
}

.msg-avatar-img {
  background: #f5f7fa;
}

.msg-main {
  flex: 1;
  min-width: 0;
}

.msg-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.msg-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}

.msg-time {
  font-size: 22rpx;
  color: #c0c4cc;
  flex-shrink: 0;
  padding-left: 12rpx;
}

.msg-preview {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #909399;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-badge {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-left: 16rpx;
  border-radius: 18rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.msg-empty {
  padding-top: 220rpx;
  text-align: center;
  color: #909399;
}

.msg-empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 28rpx;
  border-radius: 30rpx;
  background: #fff3e8;
  color: #ff7a00;
  font-size: 52rpx;
  line-height: 120rpx;
}

.msg-empty-title {
  font-size: 32rpx;
  color: #303133;
  font-weight: 600;
}

.msg-empty-sub {
  margin: 16rpx 60rpx 36rpx;
  font-size: 26rpx;
  line-height: 40rpx;
}

.msg-empty-btn {
  display: inline-block;
  min-width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #ff7a00;
  color: #fff;
  font-size: 28rpx;
}

.msg-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #c0c4cc;
}
