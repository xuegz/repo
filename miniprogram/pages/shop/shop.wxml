<wxs src="../../utils/tools.wxs" module="tools" />

<view class="page" wx:if="{{merchant.id}}">
  <view class="card">
    <image wx:if="{{merchant.logo}}" src="{{tools.thumbUrl(merchant.logo, 300)}}" mode="aspectFill" class="shop-logo" lazy-load />
    <image wx:else src="/assets/placeholder/shop-wide.jpg" mode="aspectFill" class="shop-logo" />
    <view class="shop-name">{{merchant.name}}</view>
    <view class="info-row"><text class="info-label">联系人</text><text>{{merchant.contactName || '-'}}</text></view>
    <view class="info-row"><text class="info-label">电话</text><text class="phone-link" bindtap="callPhone">{{merchant.phone}}</text></view>
    <view class="info-row" wx:if="{{merchant.marketId}}" bindtap="goMarket">
      <text class="info-label">市场</text>
      <text class="market-link">{{merchant.market || '-'}} ›</text>
    </view>
    <view class="info-row" wx:else><text class="info-label">市场</text><text>{{merchant.market || '-'}}</text></view>
    <view class="info-row"><text class="info-label">地址</text><text>{{addressText}}</text></view>
    <view class="map-link" wx:if="{{merchant.latitude && merchant.longitude}}" bindtap="goMap">在地图上查看位置 ›</view>
    <view class="shop-actions">
      <view class="shop-action-primary" bindtap="callPhone" hover-class="shop-action-hover">电话联系</view>
      <view class="shop-action-ghost" bindtap="goChat" hover-class="shop-action-hover">在线咨询</view>
      <view class="shop-action-ghost" bindtap="openNav" hover-class="shop-action-hover">到店导航</view>
      <view class="shop-action-fav {{favorited ? 'active' : ''}}" bindtap="toggleFavorite">
        <text class="shop-action-fav-icon">{{favorited ? '★' : '☆'}}</text>
        <text class="shop-action-fav-text">{{favorited ? '已收藏' : '收藏'}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{merchant.intro}}">
    <view class="section-title">商户简介</view>
    <view class="card"><view class="detail-desc">{{merchant.intro}}</view></view>
  </block>

  <view class="section-title">在售产品</view>
  <view class="product-list">
    <view class="product-card" wx:for="{{products}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" hover-class="tap-hover" hover-stay-time="60">
      <image wx:if="{{item.imageList[0]}}" src="{{tools.thumbUrl(item.imageList[0], 300)}}" mode="aspectFill" class="product-img" lazy-load />
      <image wx:else src="/assets/placeholder/product.jpg" mode="aspectFill" class="product-img" />
      <view class="product-body">
        <view class="product-name">{{item.name}}</view>
        <view class="product-meta">{{item.brand}} · {{item.origin}}</view>
        <view class="product-bottom">
          <text class="price" wx:if="{{item.price > 0}}">¥{{item.price}}<text class="unit" wx:if="{{item.unit}}">/{{item.unit}}</text></text>
          <text class="price-none" wx:else>面议</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{products.length === 0}}">该商户暂未发布在售产品</view>
</view>
