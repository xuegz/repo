<wxs src="../../utils/tools.wxs" module="tools" />

<view class="page">
  <view class="card mine-header">
    <view class="mine-user">
      <view class="mine-avatar-wrap">
        <image wx:if="{{avatar}}" class="mine-avatar-img" src="{{tools.thumbUrl(avatar, 120)}}" mode="aspectFill" />
        <view wx:else class="mine-avatar">建</view>
        <view wx:if="{{loginState === 'ok'}}" class="mine-avatar-edit">+</view>
        <button wx:if="{{loginState === 'ok'}}" class="mine-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar"></button>
      </view>
      <view class="mine-user-info">
        <input wx:if="{{loginState === 'ok'}}" class="mine-name-input" type="nickname" value="{{nickname}}" placeholder="点击设置昵称" placeholder-class="mine-name-placeholder" maxlength="20" bindblur="onNicknameBlur" bindconfirm="onNicknameBlur" />
        <view wx:else class="mine-title">{{loginState === 'loading' ? '登录中…' : '未登录'}}</view>
        <view class="mine-sub">{{loginState === 'ok' ? '已通过微信登录，数据自动同步' : '登录后同步浏览、收藏与询价'}}</view>
      </view>
      <view wx:if="{{loginState !== 'ok'}}" class="mine-login" bindtap="doLogin">{{loginState === 'loading' ? '登录中' : '微信登录'}}</view>
    </view>
  </view>

  <view class="card merchant-entry" bindtap="goMerchant">
    <view class="merchant-entry-icon">{{merchantBound ? '店' : '商'}}</view>
    <view class="merchant-entry-info">
      <view class="merchant-entry-title">{{merchantBound ? merchantShop.shopName : '商家中心'}}</view>
      <view class="merchant-entry-sub">{{merchantBound ? '发布产品 · 处理询价 · 经营数据' : '商户账号绑定后，可在小程序管理店铺'}}</view>
    </view>
    <view class="merchant-entry-btn">{{merchantBound ? '进入' : '绑定'}}</view>
  </view>

  <view class="card">
    <view class="history-head">
      <view class="section-title" style="margin: 0">我的浏览记录</view>
      <view class="history-toggle" wx:if="{{history.length > 3}}" bindtap="toggleHistory" hover-class="tap-hover">
        <text>{{historyExpanded ? '收起' : '展开全部'}}</text>
        <text class="history-toggle-arrow {{historyExpanded ? 'up' : ''}}">›</text>
      </view>
    </view>
    <block wx:for="{{history}}" wx:key="id">
      <view class="history-item" wx:if="{{historyExpanded || index < 3}}" bindtap="goDetail" data-id="{{item.id}}">
        <image wx:if="{{item.imageList[0]}}" src="{{tools.thumbUrl(item.imageList[0], 120)}}" mode="aspectFill" class="history-img" lazy-load />
        <image wx:else src="/assets/placeholder/product-small.jpg" mode="aspectFill" class="history-img" />
        <view class="history-info">
          <view class="product-name">{{item.name}}</view>
          <view class="product-meta">{{item.merchantName}}</view>
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{history.length === 0}}">还没有浏览记录</view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="goInquiries">
      <text>我的询价</text>
      <text class="menu-right">查看商户报价 ›</text>
    </view>
    <view class="menu-item" bindtap="goFavorites">
      <text>我的收藏</text>
      <text class="menu-right">产品 / 商户 ›</text>
    </view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="goApply">
      <text>商户入驻 / 推荐同行</text>
      <text class="menu-right">免费 ›</text>
    </view>
    <view class="menu-item" bindtap="goShops">
      <text>找商户</text>
      <text class="menu-right">›</text>
    </view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="goFeedback">
      <text>意见反馈</text>
      <text class="menu-right">提交建议 / 问题 ›</text>
    </view>
    <view class="menu-item" bindtap="callService">
      <text>联系客服</text>
      <text class="menu-right">{{servicePhone}}</text>
    </view>
    <view class="menu-item" bindtap="showTutorial">
      <text>使用教程</text>
      <text class="menu-right">›</text>
    </view>
    <view class="menu-item" bindtap="showDisclaimer">
      <text>免责说明</text>
      <text class="menu-right">›</text>
    </view>
    <view class="menu-item" bindtap="clearHistory">
      <text>清除浏览记录</text>
      <text class="menu-right">›</text>
    </view>
  </view>

  <view class="footer">材路通 · 让建材生意更好做</view>
</view>
