<wxs src="../../utils/tools.wxs" module="tools" />

<view class="page">
  <view class="card mine-header">
    <view class="mine-user">
      <view class="mine-avatar">建</view>
      <view class="mine-user-info">
        <view class="mine-title">{{loginState === 'ok' ? '微信用户' : (loginState === 'loading' ? '登录中…' : '未登录')}}</view>
        <view class="mine-sub">{{loginState === 'ok' ? '已通过微信登录，数据自动同步' : '登录后同步浏览、收藏与询价'}}</view>
      </view>
      <view wx:if="{{loginState === 'ok'}}" class="mine-badge">已登录</view>
      <view wx:else class="mine-login" bindtap="doLogin">{{loginState === 'loading' ? '登录中' : '微信登录'}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title" style="margin: 0 0 10rpx">我的浏览记录</view>
    <view class="history-item" wx:for="{{history}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image wx:if="{{item.imageList[0]}}" src="{{tools.thumbUrl(item.imageList[0], 120)}}" mode="aspectFill" class="history-img" lazy-load />
      <image wx:else src="/assets/placeholder/product-small.jpg" mode="aspectFill" class="history-img" />
      <view class="history-info">
        <view class="product-name">{{item.name}}</view>
        <view class="product-meta">{{item.merchantName}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{history.length === 0}}">还没有浏览记录</view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="goInquiries">
      <text>我的询价</text>
      <text class="menu-right">查看商户报价 ›</text>
    </view>
    <view class="menu-item" bindtap="goFavorites">
      <text>我的收藏</text>
      <text class="menu-right">产品 / 商户 ›</text>
    </view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="goApply">
      <text>商户入驻 / 推荐同行</text>
      <text class="menu-right">免费 ›</text>
    </view>
    <view class="menu-item" bindtap="goShops">
      <text>找商户</text>
      <text class="menu-right">›</text>
    </view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="callService">
      <text>联系客服</text>
      <text class="menu-right">{{servicePhone}}</text>
    </view>
    <view class="menu-item" bindtap="showTutorial">
      <text>使用教程</text>
      <text class="menu-right">›</text>
    </view>
    <view class="menu-item" bindtap="showDisclaimer">
      <text>免责说明</text>
      <text class="menu-right">›</text>
    </view>
    <view class="menu-item" bindtap="clearHistory">
      <text>清除浏览记录</text>
      <text class="menu-right">›</text>
    </view>
  </view>

  <view class="footer">建材商户平台 · 让建材生意更好做</view>
</view>
