<wxs src="../../utils/tools.wxs" module="tools" />

<view class="page">
  <!-- 头部：品牌 + 城市 + 搜索（自定义导航，黄色铺到状态栏） -->
  <view class="hero" style="padding-top: {{statusBarHeight}}px">
    <view class="hero-nav">
      <text class="hero-brand">材路通</text>
    </view>
    <view class="hero-sub">
      <text class="hero-slogan">找建材 · 直接对接商户</text>
      <text class="hero-city">{{city}}</text>
    </view>
    <view class="hero-search">
      <input
        class="hero-input"
        placeholder-class="hero-placeholder"
        placeholder="搜索产品 / 品牌 / 产地"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="goSearch"
      />
      <view class="hero-btn" bindtap="goSearch">搜索</view>
    </view>
  </view>

  <!-- 市场公告 -->
  <view class="notice-bar" wx:if="{{notices.length > 0}}">
    <text class="notice-label">公告</text>
    <swiper class="notice-swiper" vertical autoplay circular interval="4000">
      <swiper-item wx:for="{{notices}}" wx:key="id">
        <view class="notice-text" bindtap="showNotice" data-index="{{index}}">{{item.title}}</view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 首页轮播 -->
  <swiper class="banner" indicator-dots="true" autoplay="true" circular="true" wx:if="{{banners.length > 0}}">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image src="{{tools.thumbUrl(item.image, 400)}}" mode="aspectFill" class="banner-img" lazy-load />
    </swiper-item>
  </swiper>

  <!-- 筛选入口 -->
  <view class="entry-grid">
    <view class="entry-item" bindtap="goShops">
      <view class="entry-circle">商</view>
      <text class="entry-label">找商户</text>
    </view>
    <view class="entry-item" bindtap="goAllProducts">
      <view class="entry-circle">品</view>
      <text class="entry-label">找产品</text>
    </view>
    <view class="entry-item" bindtap="goMap">
      <view class="entry-circle">图</view>
      <text class="entry-label">地图找店</text>
    </view>
    <view class="entry-item" bindtap="goApply">
      <view class="entry-circle">驻</view>
      <text class="entry-label">免费入驻</text>
    </view>
  </view>

  <!-- 品类 -->
  <view class="section-title">建材品类</view>
  <view class="category-grid">
    <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="goCategory" data-id="{{item.id}}">
      <view class="category-icon">{{item.firstLetter}}</view>
      <text class="category-name">{{item.name}}</text>
    </view>
    <view class="category-item" bindtap="goAllProducts">
      <view class="category-icon category-icon-more">全</view>
      <text class="category-name">全部</text>
    </view>
  </view>

  <!-- 热门建材市场 -->
  <block wx:if="{{markets.length > 0}}">
    <view class="section-head">
      <view class="section-title">热门建材市场</view>
      <view class="section-more" bindtap="goAllMarkets" hover-class="tap-hover">查看全部 ›</view>
    </view>
    <scroll-view scroll-x="true" class="market-scroll">
      <view
        class="market-card"
        wx:for="{{markets}}"
        wx:key="id"
        bindtap="goMarket"
        data-id="{{item.id}}"
        hover-class="tap-hover"
        hover-stay-time="60"
      >
        <view class="market-card-name">{{item.name}}</view>
        <view class="market-card-meta">{{item.merchantCount || 0}} 家商户</view>
        <view class="market-card-address">{{item.address || item.city || '西安市'}}</view>
        <view class="market-card-more">进入市场 ›</view>
      </view>
    </scroll-view>
  </block>

  <!-- 广告位 -->
  <block wx:if="{{ads.length > 0}}">
    <view class="section-title">市场推广</view>
    <image
      wx:for="{{ads}}"
      wx:key="id"
      src="{{tools.thumbUrl(item.image, 240)}}"
      mode="aspectFill"
      class="ad-item"
      lazy-load
      bindtap="goAd"
      data-link="{{item.link}}"
    />
  </block>

  <!-- 入驻商户 -->
  <block wx:if="{{merchants.length > 0}}">
    <view class="section-title">入驻商户</view>
    <view class="shop-card" wx:for="{{merchants}}" wx:key="id" bindtap="goShop" data-id="{{item.id}}" hover-class="tap-hover" hover-stay-time="60">
      <image wx:if="{{item.logo}}" src="{{tools.thumbUrl(item.logo, 120)}}" mode="aspectFill" class="shop-avatar" lazy-load />
      <image wx:else src="/assets/placeholder/shop.jpg" mode="aspectFill" class="shop-avatar" />
      <view class="shop-info">
        <view class="shop-name-line">{{item.name}}</view>
        <view class="shop-line" wx:if="{{item.memberActive}}">{{item.market || '建材市场'}} · {{item.contactName}} {{item.phone}}</view>
        <view class="shop-line" wx:else>{{item.market || '建材市场'}} · <text class="member-inline">联系方式会员可见</text></view>
        <view class="shop-tags">
          <text class="shop-tag">在售 {{item.productCount}} 件</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 最新产品 -->
  <view class="section-title">最新产品</view>
  <view class="product-list">
    <view class="product-card" wx:for="{{recommends}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" hover-class="tap-hover" hover-stay-time="60">
      <image wx:if="{{item.imageList[0]}}" src="{{tools.thumbUrl(item.imageList[0], 300)}}" mode="aspectFill" class="product-img" lazy-load />
      <image wx:else src="/assets/placeholder/product.jpg" mode="aspectFill" class="product-img" />
      <view class="product-body">
        <view class="product-name">{{item.name}}</view>
        <view class="product-meta">{{item.brand}} · {{item.origin}}</view>
        <view class="product-bottom">
          <text class="price" wx:if="{{item.price > 0}}">¥{{item.price}}<text class="unit" wx:if="{{item.unit}}">/{{item.unit}}</text></text>
          <text class="price-none" wx:else>面议</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{recommends.length === 0}}">暂无产品，快让商户发布吧</view>
</view>
