.m-msg-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.m-msg-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.m-msg-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.m-msg-item:last-child {
  border-bottom: none;
}

.m-msg-item-hover {
  background: #f7f8fa;
}

.m-msg-avatar,
.m-msg-avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.m-msg-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef4ff;
  color: #3b7ddd;
  font-size: 34rpx;
  font-weight: 600;
}

.m-msg-avatar-img {
  background: #f5f7fa;
}

.m-msg-main {
  flex: 1;
  min-width: 0;
}

.m-msg-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.m-msg-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}

.m-msg-time {
  font-size: 22rpx;
  color: #c0c4cc;
  flex-shrink: 0;
  padding-left: 12rpx;
}

.m-msg-preview {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #909399;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-msg-badge {
  flex-shrink: 0;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-left: 16rpx;
  border-radius: 18rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.m-msg-empty {
  padding-top: 220rpx;
  text-align: center;
  color: #909399;
}

.m-msg-empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 28rpx;
  border-radius: 30rpx;
  background: #eef4ff;
  color: #3b7ddd;
  font-size: 52rpx;
  line-height: 120rpx;
}

.m-msg-empty-title {
  font-size: 32rpx;
  color: #303133;
  font-weight: 600;
}

.m-msg-empty-sub {
  margin: 16rpx 60rpx 0;
  font-size: 26rpx;
  line-height: 40rpx;
}
