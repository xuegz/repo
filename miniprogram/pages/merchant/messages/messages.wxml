<view class="m-msg-page">
  <view wx:if="{{loading}}" class="m-msg-empty">加载中…</view>

  <view wx:elif="{{list.length === 0}}" class="m-msg-empty">
    <view class="m-msg-empty-icon">信</view>
    <view class="m-msg-empty-title">暂无顾客咨询</view>
    <view class="m-msg-empty-sub">顾客在商品或店铺页点「在线咨询」后，会出现在这里</view>
  </view>

  <view wx:else class="m-msg-list">
    <view class="m-msg-item" wx:for="{{list}}" wx:key="conversationId" data-item="{{item}}" bindtap="openChat" hover-class="m-msg-item-hover" hover-stay-time="60">
      <image wx:if="{{item.userAvatar}}" class="m-msg-avatar-img" src="{{item.userAvatar}}" mode="aspectFill" />
      <view wx:else class="m-msg-avatar">{{item.initial}}</view>
      <view class="m-msg-main">
        <view class="m-msg-row">
          <text class="m-msg-name">{{item.userName}}</text>
          <text class="m-msg-time">{{item.timeText}}</text>
        </view>
        <view class="m-msg-preview">{{item.lastContent}}</view>
      </view>
      <view wx:if="{{item.unread > 0}}" class="m-msg-badge">{{item.badge}}</view>
    </view>
  </view>
</view>
