<wxs src="../../../utils/tools.wxs" module="tools" />
<view class="chat-page">
  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation bindscroll="onScroll">
    <view wx:if="{{hasMore}}" class="chat-earlier {{loadingEarlier ? 'chat-earlier-loading' : ''}}" bindtap="loadEarlier">
      {{loadingEarlier ? '加载中…' : '查看更早消息'}}
    </view>

    <view wx:if="{{loading}}" class="chat-tip">加载中…</view>

    <view wx:elif="{{empty}}" class="chat-empty">
      <view class="chat-empty-title">顾客还没有发来消息</view>
      <view class="chat-empty-sub">可以直接回复问候，或等顾客说明需求</view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="chat-row {{item.sender === 'merchant' ? 'chat-row-self' : ''}}">
      <view wx:if="{{item.type === 'text'}}" class="chat-bubble {{item.sender === 'merchant' ? 'bubble-self' : 'bubble-other'}}">{{item.content}}</view>

      <image wx:elif="{{item.type === 'image'}}" class="chat-img" src="{{item.content}}" mode="widthFix"
             data-url="{{item.content}}" bindtap="previewImage" />

      <view wx:elif="{{item.type === 'product'}}" class="chat-product" data-id="{{item.product.id}}" bindtap="openProduct">
        <image wx:if="{{item.product.image}}" class="chat-product-img" src="{{tools.thumbUrl(item.product.image, 200)}}" mode="aspectFill" />
        <view class="chat-product-info">
          <view class="chat-product-name">{{item.product.name}}</view>
          <view class="chat-product-price" wx:if="{{item.product.price > 0}}">¥{{item.product.price}}<text wx:if="{{item.product.unit}}">/{{item.product.unit}}</text></view>
          <view class="chat-product-price" wx:else>面议</view>
        </view>
      </view>

      <view class="chat-time">{{item.timeText}}</view>
    </view>

    <view class="chat-bottom-space"></view>
  </scroll-view>

  <view class="chat-bar">
    <view class="chat-bar-tool" bindtap="chooseImage">图片</view>
    <input class="chat-bar-input" value="{{input}}" placeholder="回复顾客…" placeholder-class="chat-bar-placeholder"
           confirm-type="send" cursor-spacing="20" bindinput="onInput" bindconfirm="sendText" />
    <view class="chat-bar-send {{input ? 'chat-bar-send-active' : ''}}" bindtap="sendText">发送</view>
  </view>
</view>
