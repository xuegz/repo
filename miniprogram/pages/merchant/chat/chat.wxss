page {
  height: 100%;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fa;
}

.chat-scroll {
  flex: 1;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.chat-tip {
  text-align: center;
  color: #909399;
  font-size: 26rpx;
  padding-top: 40rpx;
}

.chat-empty {
  padding: 120rpx 40rpx 0;
  text-align: center;
}

.chat-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #303133;
}

.chat-empty-sub {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #909399;
}

.chat-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 26rpx;
}

.chat-row-self {
  align-items: flex-end;
}

.chat-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 29rpx;
  line-height: 44rpx;
  word-break: break-all;
}

.bubble-other {
  background: #fff;
  color: #303133;
  border-top-left-radius: 4rpx;
}

.bubble-self {
  background: #ff7a00;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.chat-img {
  width: 360rpx;
  max-width: 70%;
  border-radius: 12rpx;
  background: #ebeef5;
}

.chat-product {
  display: flex;
  width: 500rpx;
  max-width: 76%;
  padding: 16rpx;
  background: #fff;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.chat-product-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: #f5f7fa;
}

.chat-product-info {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.chat-product-name {
  font-size: 28rpx;
  color: #303133;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.chat-product-price {
  font-size: 28rpx;
  color: #ff7a00;
  font-weight: 600;
}

.chat-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #c0c4cc;
}

.chat-bottom-space {
  height: 24rpx;
}

.chat-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f2f5;
}

.chat-bar-tool {
  width: 104rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #606266;
  background: #f5f7fa;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.chat-bar-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.chat-bar-placeholder {
  color: #c0c4cc;
}

.chat-bar-send {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 12rpx;
  background: #f0f2f5;
  color: #a8abb2;
  font-size: 28rpx;
  flex-shrink: 0;
}

.chat-bar-send-active {
  background: #ff7a00;
  color: #fff;
}
