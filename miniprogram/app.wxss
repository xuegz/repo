/* 全局样式 */
page {
  background: #f5f7fa;
  font-size: 28rpx;
  color: #303133;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 通用容器 */
.page {
  padding: 20rpx 24rpx 40rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 24rpx 0 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #409eff;
  line-height: 1;
}

/* 搜索条 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-placeholder {
  color: #909399;
}
.search-btn {
  background: #409eff;
  color: #fff;
  font-size: 26rpx;
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  margin-left: 16rpx;
}

/* 轮播 */
.banner {
  width: 100%;
  height: 280rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.banner-img {
  width: 100%;
  height: 100%;
}

/* 品类九宫格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 0;
}
.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.category-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #409eff, #66b1ff);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}
.category-name {
  font-size: 26rpx;
  color: #606266;
}

/* 产品列表 */
.product-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product-card {
  width: 49%;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
}
.product-img {
  width: 100%;
  height: 260rpx;
  background: #eceef1;
}
.product-body {
  padding: 14rpx 16rpx 18rpx;
}
.product-name {
  font-size: 27rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-meta {
  font-size: 22rpx;
  color: #909399;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}
.price {
  color: #f56c6c;
  font-size: 30rpx;
  font-weight: bold;
}
.price-none {
  color: #909399;
  font-size: 24rpx;
}
.product-shop {
  font-size: 22rpx;
  color: #909399;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #c0c4cc;
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  color: #909399;
  padding: 20rpx 0;
  font-size: 26rpx;
}

/* 广告位 */
.ad-item {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

/* 品类横向筛选 */
.cat-scroll {
  white-space: nowrap;
  width: 100%;
}
.cat-tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
  background: #fff;
  color: #606266;
  border-radius: 30rpx;
  font-size: 26rpx;
}
.cat-tab.active {
  background: #409eff;
  color: #fff;
}

/* 产品详情 */
.detail-swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.detail-img {
  width: 100%;
  height: 100%;
}
.detail-name {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.detail-price {
  color: #f56c6c;
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.unit {
  font-size: 24rpx;
  color: #909399;
}
.info-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}
.info-label {
  width: 120rpx;
  color: #909399;
}
.detail-desc {
  font-size: 27rpx;
  color: #606266;
  line-height: 1.6;
}

/* 按钮 */
.btn-row {
  display: flex;
  margin-top: 20rpx;
}
.btn-phone {
  flex: 1;
  background: #409eff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin-right: 12rpx;
}
.btn-shop {
  flex: 1;
  background: #ecf5ff;
  color: #409eff;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 1rpx solid #b3d8ff;
}
.tip-row {
  text-align: center;
  color: #909399;
  font-size: 24rpx;
  margin-top: 20rpx;
}

/* 商户主页 */
.shop-name {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

/* 个人中心 */
.mine-header {
  background: linear-gradient(135deg, #1f2937, #409eff);
  color: #fff;
}
.mine-title {
  font-size: 34rpx;
  font-weight: bold;
}
.mine-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.history-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.history-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #eceef1;
  flex-shrink: 0;
}
.history-info {
  margin-left: 18rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-right {
  color: #c0c4cc;
}
.footer {
  text-align: center;
  color: #c0c4cc;
  font-size: 24rpx;
  padding: 30rpx 0;
}
