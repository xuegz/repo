/* 全局样式 */
page {
  background: #f5f7fa;
  font-size: 28rpx;
  color: #303133;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 品牌色板：主色 #ff7a00 / 深色文字 #b85000 / 浅底 #fff4e8 / 描边 #ffd9b3 / 导航黄 #ffc93c / 价格 #f56c6c */
.page {
  padding: 20rpx 24rpx 40rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 24rpx 0 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #ff7a00;
  line-height: 1;
}

/* 搜索条 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-placeholder {
  color: #909399;
}
.search-btn {
  background: #ff7a00;
  color: #fff;
  font-size: 26rpx;
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  margin-left: 16rpx;
}

/* 轮播 */
.banner {
  width: 100%;
  height: 280rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.banner-img {
  width: 100%;
  height: 100%;
}

/* 品类九宫格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 0;
}
.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.category-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7a00, #ff9a3c);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}
.category-name {
  font-size: 26rpx;
  color: #606266;
}
.category-icon-more {
  background: #fff4e8;
  color: #ff7a00;
}

/* 产品列表 */
.product-list {
  display: block;
}
.product-card {
  position: relative;
  display: flex;
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.product-img {
  width: 220rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #eceef1;
  flex-shrink: 0;
}
.product-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 4rpx 4rpx 4rpx 20rpx;
  overflow: hidden;
}
.product-name {
  font-size: 29rpx;
  font-weight: bold;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  white-space: normal;
  overflow: hidden;
}
.product-meta {
  font-size: 23rpx;
  color: #909399;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 8rpx;
}
.price {
  color: #f56c6c;
  font-size: 34rpx;
  font-weight: bold;
}
.price-none {
  color: #909399;
  font-size: 24rpx;
}
.product-shop {
  font-size: 22rpx;
  color: #909399;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #c0c4cc;
  padding: 80rpx 0;
  font-size: 28rpx;
}

/* 加载提示 */
.loading-tip {
  text-align: center;
  color: #909399;
  padding: 20rpx 0;
  font-size: 26rpx;
}

/* 广告位 */
.ad-item {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

/* 品类横向筛选 */
.cat-scroll {
  white-space: nowrap;
  width: 100%;
}
.cat-tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 14rpx;
  background: #fff;
  color: #606266;
  border-radius: 30rpx;
  font-size: 26rpx;
}
.cat-tab.active {
  background: #ff7a00;
  color: #fff;
}

/* 产品详情 */
.detail-swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.detail-img {
  width: 100%;
  height: 100%;
}
.detail-name {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.detail-price {
  color: #f56c6c;
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.unit {
  font-size: 24rpx;
  color: #909399;
}
.info-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 26rpx;
}
.info-label {
  width: 120rpx;
  color: #909399;
}
.info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.info-link {
  font-size: 24rpx;
  color: #ff7a00;
  padding: 10rpx 0;
}
.detail-desc {
  font-size: 27rpx;
  color: #606266;
  line-height: 1.6;
}

/* 按钮 */
.btn-row {
  display: flex;
  margin-top: 20rpx;
}
.btn-phone {
  flex: 1;
  background: #ff7a00;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin-right: 12rpx;
}
.btn-shop {
  flex: 1;
  background: #ecf5ff;
  color: #ff7a00;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 1rpx solid #ffd9b3;
}
.tip-row {
  text-align: center;
  color: #909399;
  font-size: 24rpx;
  margin-top: 20rpx;
}

/* 商户主页 */
.shop-name {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

/* 个人中心 */
.mine-header {
  background: linear-gradient(135deg, #e8590c, #ff7a00);
  color: #fff;
}
.mine-user {
  display: flex;
  align-items: center;
}
.mine-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  color: #ff7a00;
  font-size: 38rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.mine-avatar-wrap {
  position: relative;
  flex: 0 0 96rpx;
  width: 96rpx;
  height: 96rpx;
}
.mine-avatar-btn {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
}
.mine-avatar-btn::after {
  border: none;
}
.mine-avatar-img {
  display: block;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
}
.mine-avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #ff7a00;
  box-sizing: border-box;
  color: #ff7a00;
  font-size: 26rpx;
  line-height: 30rpx;
  text-align: center;
}
.mine-user-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}
.mine-name-input {
  width: 100%;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}
.mine-name-placeholder {
  color: rgba(255, 255, 255, 0.75);
  font-weight: normal;
}
.mine-login {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #ff7a00;
  font-size: 24rpx;
  font-weight: bold;
}
.mine-title {
  font-size: 34rpx;
  font-weight: bold;
}
.mine-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.history-toggle {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #ff7a00;
  padding: 8rpx 0 8rpx 20rpx;
}
.history-toggle-arrow {
  margin-left: 6rpx;
  display: inline-block;
  transform: rotate(90deg);
  transition: transform 0.2s;
}
.history-toggle-arrow.up {
  transform: rotate(-90deg);
}
.history-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.history-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  background: #eceef1;
  flex-shrink: 0;
}
.history-info {
  margin-left: 18rpx;
  overflow: hidden;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-right {
  color: #c0c4cc;
}
.footer {
  text-align: center;
  color: #c0c4cc;
  font-size: 24rpx;
  padding: 30rpx 0;
}

/* 「我的」页会员横幅与数据栏 */
.member-card {
  padding: 0;
  overflow: hidden;
}
.member-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  background: linear-gradient(135deg, #4a2c10, #8a4b12);
}
.member-no {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffe3b0;
  letter-spacing: 1rpx;
}
.member-slogan {
  font-size: 22rpx;
  color: #ffd66b;
  letter-spacing: 1rpx;
}
.member-stats {
  display: flex;
  padding: 22rpx 0;
  background: #fff;
}
.member-stat {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.member-stat + .member-stat::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: #f0f2f5;
}
.member-stat-num {
  font-size: 38rpx;
  font-weight: bold;
  color: #ff7a00;
  line-height: 1.2;
}
.member-stat-label {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #909399;
}

/* 会员权益门禁 */
.member-lock {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 24rpx 26rpx;
  background: linear-gradient(135deg, #fff8ea, #ffefd2);
  border: 1rpx solid #ffd9a0;
  border-radius: 16rpx;
}
.member-lock-icon {
  flex-shrink: 0;
  margin-right: 18rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ff7a00;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
.member-lock-main {
  flex: 1;
  min-width: 0;
}
.member-lock-title {
  font-size: 27rpx;
  font-weight: bold;
  color: #8a4b12;
}
.member-lock-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a87343;
  line-height: 1.5;
}
.member-lock-btn {
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  color: #fff;
  font-size: 24rpx;
}
.member-inline {
  color: #ff7a00;
}
.member-card-lock {
  padding: 10rpx 0 6rpx;
  text-align: center;
}
.member-card-lock-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #8a4b12;
}
.member-card-lock-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a87343;
  line-height: 1.5;
}
.member-card-lock-btn {
  display: inline-block;
  margin-top: 18rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  color: #fff;
  font-size: 24rpx;
}

/* 我的页商家中心入口 */
.merchant-entry {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.merchant-entry-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ff7a00, #ff9a3c);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.merchant-entry-info {
  flex: 1;
  margin-left: 18rpx;
  overflow: hidden;
}
.merchant-entry-title {
  font-size: 30rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.merchant-entry-sub {
  font-size: 23rpx;
  color: #909399;
  margin-top: 6rpx;
}
.merchant-entry-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #fff4e8;
  color: #ff7a00;
  font-size: 24rpx;
}

/* 首页快捷入口 */
.entry-row {
  display: flex;
  margin-top: 16rpx;
}
.entry-card {
  flex: 1;
  background: #fff;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  margin-right: 16rpx;
}
.entry-card:last-child {
  margin-right: 0;
  background: linear-gradient(135deg, #ff7a00, #ff9a3c);
}
.entry-card:last-child .entry-title,
.entry-card:last-child .entry-sub {
  color: #fff;
}
.entry-card:last-child .entry-sub {
  color: rgba(255, 255, 255, 0.85);
}
.entry-title {
  font-size: 28rpx;
  font-weight: bold;
}
.entry-sub {
  font-size: 21rpx;
  color: #909399;
  margin-top: 4rpx;
}

/* 商户卡片 */
.shop-card {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.shop-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #eceef1;
  flex-shrink: 0;
}
.shop-info {
  flex: 1;
  margin-left: 18rpx;
  overflow: hidden;
}
.shop-name-line {
  font-size: 30rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-line {
  font-size: 24rpx;
  color: #606266;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-line.gray {
  color: #909399;
}
.shop-tags {
  margin-top: 10rpx;
}
.shop-tag {
  display: inline-block;
  background: #fff4e8;
  color: #ff7a00;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}
.shop-logo {
  width: 100%;
  height: 220rpx;
  border-radius: 10rpx;
  margin-bottom: 14rpx;
}

/* 入驻入口条 */
.apply-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
}
.apply-entry-btn {
  background: #ff7a00;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
}

/* 入驻表单 */
.apply-header {
  background: linear-gradient(135deg, #e8590c, #ff7a00);
}
.apply-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}
.apply-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}
.apply-inviter {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  color: #fff;
  line-height: 1.5;
}
.form-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.form-label {
  font-size: 27rpx;
  color: #606266;
  margin-bottom: 10rpx;
}
.req {
  color: #f56c6c;
}
.form-input {
  font-size: 28rpx;
  color: #303133;
}
.form-row {
  display: flex;
}
.form-row .form-item.half {
  flex: 1;
}
.form-row .form-item.half:first-child {
  margin-right: 20rpx;
}
.picker-view {
  font-size: 28rpx;
  color: #303133;
}
.picker-view.placeholder {
  color: #c0c4cc;
}
.upload-box {
  width: 240rpx;
  height: 160rpx;
  border: 1rpx dashed #d9d9d9;
  border-radius: 10rpx;
  overflow: hidden;
}
.logo-img {
  width: 100%;
  height: 100%;
}
.upload-tip {
  width: 100%;
  height: 100%;
  color: #909399;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.form-textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
}
.submit-btn {
  flex-shrink: 0;
  margin-top: 30rpx;
  background: #ff7a00;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
}
.apply-note {
  font-size: 22rpx;
  color: #909399;
  margin-top: 16rpx;
}

/* 排序栏 */
.sort-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 12rpx 0;
}
.sort-tab {
  font-size: 25rpx;
  color: #606266;
  margin-right: 24rpx;
  padding: 10rpx 6rpx;
}
.sort-tab.active {
  color: #ff7a00;
  font-weight: bold;
}
.sort-entry {
  margin-left: auto;
  font-size: 25rpx;
  color: #ff7a00;
}

/* 历史 / 热门搜索 */
.hot-panel {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.panel-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #909399;
  margin-bottom: 14rpx;
}
.clear-history {
  color: #c0c4cc;
}
.word-list {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}
.word {
  background: #f2f4f7;
  color: #606266;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  margin: 0 14rpx 14rpx 0;
}
.word.hot {
  background: #fff4e8;
  color: #ff7a00;
}

/* 价格对比 */
.compare-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.compare-info {
  flex: 1;
  overflow: hidden;
}
.compare-shop {
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.compare-meta {
  font-size: 22rpx;
  color: #909399;
  margin-top: 4rpx;
}
.compare-right {
  text-align: right;
  margin-left: 16rpx;
}
.compare-price {
  color: #f56c6c;
  font-size: 30rpx;
  font-weight: bold;
}
.compare-call {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ff7a00;
  border: 1rpx solid #ffd9b3;
  background: #fff4e8;
}
.compare-tip {
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 14rpx;
}
.compare-empty {
  font-size: 26rpx;
  color: #909399;
  text-align: center;
  padding: 10rpx 0;
}

/* 价格更新时间 */
.price-time {
  font-size: 22rpx;
  color: #909399;
  margin-top: -6rpx;
  margin-bottom: 10rpx;
}

/* 比价摘要 */
.compare-summary {
  background: #fff4e8;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 8rpx;
}
.compare-summary-main {
  font-size: 32rpx;
  font-weight: bold;
  color: #f56c6c;
}
.compare-summary-sub {
  font-size: 22rpx;
  color: #909399;
  margin-top: 6rpx;
}

/* 详情页固定底部操作栏 */
.detail-bottom-space {
  height: 150rpx;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}
.bar-btn {
  flex: 1;
  margin: 0 12rpx 0 0;
  padding: 0;
  font-size: 28rpx;
  line-height: 76rpx;
  border-radius: 40rpx;
}
.bar-btn:last-child {
  margin-right: 0;
}
.bar-btn::after {
  border: none;
}
.bar-ghost {
  flex: 0.8;
  background: #f2f4f7;
  color: #606266;
}
.bar-primary {
  background: #ff7a00;
  color: #fff;
}
.bar-accent {
  background: #fff4e8;
  color: #ff7a00;
  border: 1rpx solid #ffd9b3;
}

/* 市场公告条 */
.notice-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-top: 20rpx;
}
.notice-label {
  color: #ff7a00;
  font-weight: bold;
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.notice-swiper {
  height: 36rpx;
  flex: 1;
}
.notice-text {
  font-size: 25rpx;
  color: #606266;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 36rpx;
}

/* 详情页询价按钮 */
.btn-inquiry {
  flex: 1;
  background: #ff7a00;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 询价留资弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.inquiry-panel {
  width: 620rpx;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx 30rpx;
  box-sizing: border-box;
}
.panel-title {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
}
.inquiry-body {
  flex-shrink: 0;
}
.inquiry-input {
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 27rpx;
  margin-bottom: 18rpx;
}
.inquiry-textarea {
  width: 100%;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 27rpx;
  height: 140rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
}
.inquiry-tip {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #909399;
  text-align: center;
  margin-top: 14rpx;
}

/* 地图找商户 */
.map-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f5f7fa;
}
.map-canvas {
  width: 100%;
  height: 100%;
}
.map-top {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f3;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.map-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1f2937;
}
.map-filter {
  font-size: 24rpx;
  color: #ff7a00;
  background: #fff4e8;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.map-tip {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 130rpx;
  padding: 12rpx 20rpx;
  background: rgba(31, 41, 55, 0.82);
  color: #ffffff;
  font-size: 23rpx;
  text-align: center;
  border-radius: 10rpx;
}
.map-card {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 40rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f3;
  border-radius: 20rpx;
  box-sizing: border-box;
}
.map-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.map-card-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
}
.map-card-close {
  width: 64rpx;
  font-size: 40rpx;
  line-height: 56rpx;
  color: #c0c4cc;
  text-align: center;
}
.map-card-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #606266;
}
.map-card-address {
  font-size: 22rpx;
  color: #909399;
}
.map-card-actions {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}
.map-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  text-align: center;
  border-radius: 34rpx;
}
.map-btn:last-child {
  margin-right: 0;
}
.map-btn-ghost {
  background: #f2f4f7;
  color: #606266;
}
.map-btn-primary {
  background: #fff4e8;
  color: #ff7a00;
}
.map-btn-accent {
  background: #ff7a00;
  color: #ffffff;
}
.map-hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #c0c4cc;
  text-align: center;
}
.map-list-entry {
  position: absolute;
  right: 24rpx;
  bottom: 40rpx;
  padding: 14rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid #ffd9b3;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #ff7a00;
}

/* 商户主页地图链接 */
.map-link {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #ff7a00;
  text-align: right;
}
.market-link {
  color: #ff7a00;
}
.phone-link {
  color: #ff7a00;
}

/* 详情页底栏收藏 */
.bar-icon {
  width: 92rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.bar-icon-char {
  font-size: 34rpx;
  line-height: 1;
  color: #909399;
}
.bar-icon-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #909399;
}
.bar-icon.active .bar-icon-char,
.bar-icon.active .bar-icon-label {
  color: #ff7a00;
}

/* 询价弹层日期选择 */
.inquiry-picker {
  color: #303133;
}
.inquiry-picker.placeholder {
  color: #909399;
}

/* 商户主页收藏按钮 */
.btn-fav {
  flex: 1;
  margin-left: 12rpx;
  background: #fff;
  color: #606266;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 1rpx solid #e5e7eb;
}

/* 商户列表工具栏：排序 + 地图入口 */
.shop-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 8rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
}
.sort-tabs {
  display: flex;
  align-items: center;
}
.sort-tabs .sort-tab {
  margin-right: 12rpx;
}
.sort-tabs .sort-tab:last-child {
  margin-right: 0;
}
.toolbar-map {
  display: flex;
  align-items: center;
  padding: 12rpx 0 12rpx 20rpx;
  border-left: 1rpx solid #f0f2f5;
  font-size: 24rpx;
  color: #ff7a00;
}
.toolbar-map-count {
  margin-left: 8rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  background: #fff4e8;
  font-size: 20rpx;
  line-height: 30rpx;
}
.toolbar-arrow {
  margin-left: 8rpx;
  color: #ff9a3c;
  font-size: 30rpx;
  line-height: 1;
}
.shop-tag.distance {
  background: #fff4e8;
  color: #b85000;
  border: 1rpx solid #ffe2c2;
}
.shop-tag.muted-tag {
  background: #f2f4f7;
  color: #909399;
}
.shop-tag.cancel {
  background: #f2f4f7;
  color: #909399;
}

/* 我的询价 */
.inquiry-tabs {
  margin-bottom: 16rpx;
}
.subscribe-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7ec;
  border: 1rpx solid #ffe2c2;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 16rpx;
}
.subscribe-tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #b85000;
}
.subscribe-tip-btn {
  flex: none;
  margin-left: 20rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #ff7a00;
  color: #fff;
  font-size: 24rpx;
}
.inquiry-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.inquiry-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.inquiry-product {
  display: flex;
  flex: 1;
  overflow: hidden;
}
.inquiry-product-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  background: #eceef1;
  flex-shrink: 0;
}
.inquiry-product-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}
.inquiry-meta {
  margin-top: 14rpx;
}
.inquiry-meta-row {
  display: block;
  font-size: 24rpx;
  color: #606266;
  line-height: 1.8;
  word-break: break-all;
}
.status-pill {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.status-pill.pending {
  background: #fff4e8;
  color: #ff7a00;
}
.status-pill.quoted {
  background: #e8f7ee;
  color: #18a058;
}
.status-pill.follow {
  background: #f2f4f7;
  color: #909399;
}
.quote-box {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #fffaf4;
  border: 1rpx solid #ffe2c2;
  border-radius: 10rpx;
}
.quote-title {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: bold;
  color: #b85000;
}
.quote-time {
  font-size: 22rpx;
  font-weight: normal;
  color: #c0a080;
}
.quote-price-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.quote-price {
  margin-right: 24rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #f56c6c;
}
.quote-badge {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  background: #f2f4f7;
  color: #909399;
  font-size: 20rpx;
  font-weight: normal;
}
.quote-box.expired {
  background: #f7f8fa;
  border-color: #e5e7eb;
}
.quote-box.expired .quote-title {
  color: #909399;
}
.quote-box.expired .quote-price {
  color: #909399;
  text-decoration: line-through;
}
.quote-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #909399;
  word-break: break-all;
}
.inquiry-actions {
  display: flex;
  margin-top: 18rpx;
}
.inquiry-btn {
  flex: 1;
  margin-right: 12rpx;
  padding: 0;
  font-size: 24rpx;
  line-height: 64rpx;
  background: #f2f4f7;
  color: #606266;
  border-radius: 32rpx;
}
.inquiry-btn:last-child {
  margin-right: 0;
}
.inquiry-btn.accent {
  background: #fff4e8;
  color: #ff7a00;
  border: 1rpx solid #ffd9b3;
}
.inquiry-btn::after {
  border: none;
}

/* 我的收藏 */
.fav-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 5;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 30rpx;
  text-align: center;
}

/* 卡片按下反馈 */
.tap-hover {
  opacity: 0.75;
}

/* 建材市场卡片（首页 / 商户列表横向滚动） */
.market-scroll {
  white-space: nowrap;
  width: 100%;
}
.market-card {
  display: inline-block;
  vertical-align: top;
  width: 320rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-right: 16rpx;
  box-sizing: border-box;
  white-space: normal;
}
.market-card:last-child {
  margin-right: 0;
}
.market-card-name {
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1.35;
  height: 76rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.market-card-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #ff7a00;
}
.market-card-address {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #909399;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.market-card-more {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #ff7a00;
  text-align: right;
}

/* 市场详情 */
.market-hero {
  background: linear-gradient(135deg, #e8590c, #ff7a00);
  border-radius: 16rpx;
  padding: 30rpx 24rpx;
  color: #fff;
  margin-bottom: 20rpx;
}
.market-hero-name {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1.35;
}
.market-hero-meta {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
  line-height: 1.5;
}
.market-stats {
  display: flex;
  margin-top: 24rpx;
}
.market-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.market-stat-num {
  font-size: 40rpx;
  font-weight: bold;
}
.market-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}
.market-actions {
  display: flex;
  margin-top: 24rpx;
}
.market-action {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
}
.market-action.ghost {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  margin-right: 12rpx;
}
.market-action.primary {
  background: #fff;
  color: #ff7a00;
  font-weight: bold;
}
.market-intro-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.market-intro {
  font-size: 25rpx;
  color: #606266;
  line-height: 1.7;
}
.market-call {
  flex-shrink: 0;
  align-self: center;
  margin-left: 12rpx;
  padding: 10rpx 24rpx;
  border: 1rpx solid #ffd9b3;
  border-radius: 30rpx;
  font-size: 23rpx;
  color: #ff7a00;
  background: #fff4e8;
}

